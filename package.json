{
  "name": "viewport",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "verify": "npm test && npm run build",
    "artwork": "node scripts/create-artwork.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "@types/node": "22.19.7"
  }
}
